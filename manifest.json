{
  "manifest_version": 3,
  "name": "EduAccess AI",
  "version": "1.0",
  "description": "AI-Powered Accessibility Assistant",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*.youtube.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
