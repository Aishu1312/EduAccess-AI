# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=eduaccess_secret_key

# OpenAI / Gemini API Keys
OPENAI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here
SECRET_KEY=your_secret_key

# Speech Features
ENABLE_SPEECH=true

# OCR Features
ENABLE_OCR=true

# Emotion Detection
ENABLE_EMOTION_AI=true

# Study Planner
ENABLE_STUDY_PLANNER=true

# Database (Optional)
DATABASE_URL=sqlite:///eduaccess.db

# Deployment Settings
PORT=5000
DEBUG=True
